[Version]
Signature   = "$Windows NT$"
Provider    = "Intel"
CatalogFile = iqvsw64e.cat
DriverVer = 04/23/2025,1.5.0.20
Class       = NALDevice
ClassGuid   = {b83400f8-b7b2-4bb7-8fe3-d179eddb8e8b}
PnpLockdown = 1

[SourceDisksNames]
1 = %DISKNAME%,,,

[SourceDisksFiles]
iqvsw64e.sys = 1,,

[DefaultInstall.NTAMD64]
CopyFiles = iQV.CopyFiles

[DefaultUninstall.NTAMD64]
LegacyUninstall = 1
DelFiles = iQV.DelFiles

[DestinationDirs]
iQV.CopyFiles = 12    ; Destination for iQV.CopyFiles section is %system32\drivers
iQV.DelFiles  = 12    ; Destination for iQV.DelFiles section is %system32\drivers

[iQV.CopyFiles]
iqvsw64e.sys,,,2

[iQV.DelFiles]
iqvsw64e.sys,,,2

[Strings]
DISKNAME="Intel(R) Tools SDK Disk"

[ClassInstall32]
Addreg=iQVDriverRegister

[iQVDriverRegister]
;HKR,,,,%ClassName%
HKR,,Icon,,"-5"
HKR,,Security,,"D:P(A;;GA;;;SY)(A;;GA;;;BA)" ;System and Admin only access
